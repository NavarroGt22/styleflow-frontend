// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------
enum Role {
  SUPER_ADMIN
  OWNER
  PROFESSIONAL
  CUSTOMER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED_BY_CUSTOMER
  CANCELED_BY_SALON
  COMPLETED
  NO_SHOW
  BLOCKED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

// Usuário central do sistema
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String
  phone          String?
  role           Role      @default(CUSTOMER)
  
  // Controle de Deleção (LGPD)
  isActive       Boolean   @default(true)
  deletedAt      DateTime? // Soft Delete (Direito ao esquecimento)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relacionamentos
  ownedSalons         Salon[]               @relation("SalonOwner")
  professionalProfile ProfessionalProfile?
  customerProfile     CustomerProfile?
  lgpdLogs            LgpdLog[]
  movedQueueEntries   QueueEntry[]          @relation("QueueEntryMover")
  refreshTokens       RefreshToken[]
}


// Perfil do Cliente (dados adicionais e preferências)
model CustomerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  dateOfBirth DateTime?
  notes       String?  // Observações personalizadas do salão para o cliente

  appointments Appointment[]
}

// Dados do Salão/Barbearia
model Salon {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("SalonOwner", fields: [ownerId], references: [id])
  
  name        String
  slug        String   @unique // Link público: app.com/barbearia-do-joao
  cnpj        String?
  address     String?
  phone       String?
  openTime    String   @default("09:00") // Horário de abertura
  closeTime   String   @default("18:00") // Horário de fechamento
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  productCommissionEnabled Boolean @default(false)
  productCommissionRate    Float   @default(10.0)
  
  instagramUrl             String?

  services      Service[]
  professionals ProfessionalProfile[]
  appointments  Appointment[]
  financials    FinancialRecord[]
  products      Product[]
  productSales  ProductSale[]

  queueMode                Boolean @default(false)
  queueAutoAdvance         Boolean @default(false)
  queueAllowClientView     Boolean @default(true)
  queueNotifyClient        Boolean @default(false)
  queueNotifyAhead         Int     @default(2)
  queueAllowSkip           Boolean @default(false)
  queueSkipTimeoutMin      Int     @default(15)
  whatsappTemplate         String? @default("Olá {cliente}, seu atendimento no {estabelecimento} está chegando! Você é o {posicao}º da fila com previsão para as {tempo}.")
  whatsappGatewayUrl       String?
  whatsappGatewayToken     String?

  queueSessions            QueueSession[]
}

// Perfil do Profissional (Barbeiro/Cabeleireiro)
model ProfessionalProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id])
  
  commissionRate Float   // Percentual ou valor fixo da comissão
  workStart      String  @default("09:00") // Início do expediente
  workEnd        String  @default("18:00") // Fim do expediente
  isActive       Boolean @default(true)
  queueMode      Boolean @default(false) // false = Agenda Comercial, true = Fila Dinâmica

  services      Service[]     @relation("ProfessionalServices")
  appointments  Appointment[]
  timecards     Timecard[]
  productSales  ProductSale[]
  queueSessions QueueSession[]
}

// Catálogo de Serviços
model Service {
  id          String   @id @default(uuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id])
  
  name        String
  description String?
  price       Float
  duration    Int      // Duração estimada em minutos
  isActive    Boolean  @default(true)

  professionals ProfessionalProfile[] @relation("ProfessionalServices")
  appointments  Appointment[]
}

// Agendamentos
model Appointment {
  id              String            @id @default(uuid())
  salonId         String
  salon           Salon             @relation(fields: [salonId], references: [id])
  
  customerId      String?
  customer        CustomerProfile?  @relation(fields: [customerId], references: [id])
  
  professionalId  String
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])
  
  serviceId       String?
  service         Service?          @relation(fields: [serviceId], references: [id])
  
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(PENDING)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  financialRecord FinancialRecord?
  queueEntry      QueueEntry?
}

// Gestão Financeira
model FinancialRecord {
  id             String        @id @default(uuid())
  salonId        String
  salon          Salon         @relation(fields: [salonId], references: [id])
  
  appointmentId  String?       @unique
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  
  amount         Float
  paymentMethod  PaymentMethod
  isExpense      Boolean       @default(false)
  isClosed       Boolean       @default(false) // Flag de Fechamento de Caixa
  description    String?       // Ex: "Receita - Corte", "Despesa - Luz"
  
  createdAt      DateTime      @default(now())
  
  productSale    ProductSale?
}

// Logs de Conformidade com a LGPD
model LgpdLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  
  action       String   // Ex: "TERMS_ACCEPTED", "DATA_REQUESTED", "DATA_DELETED", "CONSENT_REVOKED"
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())
}

// Controle de Ponto Eletrônico
model Timecard {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  date           String              // Formato YYYY-MM-DD
  clockIn        DateTime            @default(now())
  clockOut       DateTime?
  createdAt      DateTime            @default(now())

  @@index([professionalId, date])
}

model Product {
  id             String        @id @default(uuid())
  salonId        String
  salon          Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  name           String
  description    String?
  price          Float         // Preço de venda ao consumidor
  costPrice      Float?        // Preço de custo de compra (para cálculo de lucro puro)
  stockQuantity  Int           @default(0) // Quantidade atual em estoque
  minStockAlert  Int           @default(5) // Quantidade mínima para alertar estoque baixo
  
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sales          ProductSale[]
}

model ProductSale {
  id                String           @id @default(uuid())
  salonId           String
  salon             Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  
  professionalId    String?
  professional      ProfessionalProfile? @relation(fields: [professionalId], references: [id])
  
  quantity          Int
  unitPrice         Float            // Preço unitário no momento exato da venda
  paymentMethod     PaymentMethod
  
  financialRecordId String?          @unique
  financialRecord   FinancialRecord? @relation(fields: [financialRecordId], references: [id])
  
  createdAt         DateTime         @default(now())
}

// ------------------------------------------------------
// QUEUE SYSTEM
// ------------------------------------------------------

enum QueueEntryStatus {
  WAITING
  IN_PROGRESS
  DONE
  SKIPPED
  NO_SHOW
}

model QueueSession {
  id              String               @id @default(uuid())
  salonId         String
  salon           Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  professionalId  String
  professional    ProfessionalProfile  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  date            String               // Formato YYYY-MM-DD
  isOpen          Boolean              @default(true)
  createdAt       DateTime             @default(now())

  entries         QueueEntry[]

  @@unique([professionalId, date])
}

model QueueEntry {
  id               String           @id @default(uuid())
  queueSessionId   String
  queueSession     QueueSession     @relation(fields: [queueSessionId], references: [id], onDelete: Cascade)
  appointmentId    String           @unique
  appointment      Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  position         Int              // Posição atual do cliente na fila
  originalPosition Int              // Posição na criação (para fins de auditoria)
  estimatedStart   DateTime?        // Projetado dinamicamente
  actualStart      DateTime?        // Quando realmente começou
  actualEnd        DateTime?        // Quando realmente terminou
  status           QueueEntryStatus @default(WAITING)
  
  movedById        String?
  movedBy          User?            @relation("QueueEntryMover", fields: [movedById], references: [id])
  moveReason       String?
  
  createdAt        DateTime         @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}



