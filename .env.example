# API de produção (Railway) — copie a URL exata do painel Networking
NEXT_PUBLIC_API_URL=https://styleflow-backend-production-3112.up.railway.app

# Use true para liberar o painel admin com dados mockados (sem login)
# Use false quando NEXT_PUBLIC_API_URL estiver configurada
NEXT_PUBLIC_USE_MOCK_ADMIN=false

# Opcional — links do StyleFlow Master (cliente/admin)
# NEXT_PUBLIC_PLATFORM_URL=https://seu-app.vercel.app
# NEXT_PUBLIC_BASE_DOMAIN=styleflow.com
# BFF do acesso de suporte. Valores apenas no servidor.
SUPPORT_ADMIN_ORIGIN=
SUPPORT_ALLOWED_GESTAO_ORIGIN=
SUPPORT_API_BASE_URL=
# Segredo próprio do ambiente, com pelo menos 32 bytes.
SUPPORT_SESSION_SECRET=

# Gestão incorporada ao Master (sem novo deployment).
PLATFORM_MANAGEMENT_ENABLED=false
PLATFORM_ADMIN_ORIGIN=
PLATFORM_API_BASE_URL=
