# API de produção (Railway) — copie a URL exata do painel Networking
NEXT_PUBLIC_API_URL=https://styleflow-backend-production-3112.up.railway.app

# Use true para liberar o painel admin com dados mockados (sem login)
# Use false quando NEXT_PUBLIC_API_URL estiver configurada
NEXT_PUBLIC_USE_MOCK_ADMIN=false

