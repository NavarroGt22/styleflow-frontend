# URL da API (backend) — obrigatório em produção (com https://)
VITE_API_URL=https://styleflow-backend-production.up.railway.app

# WebSocket da API — opcional (derivado de VITE_API_URL se omitido)
# VITE_WS_URL=wss://styleflow-backend-production.up.railway.app

# Domínio base da plataforma (hostname do front na Vercel, sem https://)
VITE_BASE_DOMAIN=styleflow-frontend-seven.vercel.app

# URL completa do front na Vercel — usada para montar links de admin/cliente
VITE_PLATFORM_URL=https://styleflow-frontend-seven.vercel.app

# Caminhos do painel (opcional — padrões abaixo)
# VITE_ADMIN_LOGIN_PATH=/login
# VITE_SUPER_ADMIN_PATH=/platform/super

# Hosts extras tratados como plataforma (vírgula, opcional)
# VITE_PLATFORM_HOSTS=meudominio.com.br,www.meudominio.com.br

# Protótipo admin v0 — ambiente de teste (slug leleco em /admin/leleco)
VITE_ADMIN_PROTOTYPE=true
VITE_ADMIN_PROTOTYPE_SLUGS=leleco
